logging {
  level  = sys.env("LOG_LEVEL")
  format = "logfmt"
}

otelcol.auth.bearer "ingress" {
  token = sys.env("OTEL_BRIDGE_API_KEY")
}

otelcol.auth.bearer "bridge" {
  token = sys.env("OTEL_BRIDGE_API_KEY")
}

otelcol.auth.basic "langfuse" {
  username = sys.env("LANGFUSE_INIT_PROJECT_PUBLIC_KEY")
  password = sys.env("LANGFUSE_INIT_PROJECT_SECRET_KEY")
}

otelcol.receiver.otlp "claude_code" {
  http {
    endpoint = "0.0.0.0:4318"
    auth     = otelcol.auth.bearer.ingress.handler
  }

  output {
    logs    = [otelcol.processor.batch.bridge.input]
    metrics = [otelcol.processor.batch.bridge.input]
    traces  = [otelcol.processor.transform.langfuse_semantics.input]
  }
}

otelcol.processor.transform "langfuse_semantics" {
  error_mode = "ignore"

  trace_statements {
    context = "span"
    statements = [
      `set(span.attributes["langfuse.session.id"], span.attributes["session.id"]) where span.attributes["langfuse.session.id"] == nil and span.attributes["session.id"] != nil`,
      `set(span.attributes["langfuse.user.id"], span.attributes["user.email"]) where span.attributes["langfuse.user.id"] == nil and span.attributes["user.email"] != nil`,
      `set(span.attributes["langfuse.user.id"], span.attributes["user.id"]) where span.attributes["langfuse.user.id"] == nil and span.attributes["user.id"] != nil`,
      `set(span.attributes["langfuse.release"], resource.attributes["service.version"]) where span.attributes["langfuse.release"] == nil and resource.attributes["service.version"] != nil`,
      `set(span.attributes["langfuse.version"], resource.attributes["service.version"]) where span.attributes["langfuse.version"] == nil and resource.attributes["service.version"] != nil`,
      `set(span.attributes["langfuse.environment"], "production") where span.attributes["langfuse.environment"] == nil`,

      `set(span.attributes["langfuse.trace.input"], span.attributes["user_prompt"]) where span.attributes["langfuse.trace.input"] == nil and span.attributes["user_prompt"] != nil`,
      `set(span.attributes["langfuse.observation.input"], span.attributes["user_prompt"]) where span.attributes["langfuse.observation.input"] == nil and span.attributes["user_prompt"] != nil`,
      `set(span.attributes["langfuse.observation.input"], span.attributes["tool_input"]) where span.attributes["langfuse.observation.input"] == nil and span.attributes["tool_input"] != nil`,
      `set(span.attributes["langfuse.observation.input"], span.attributes["tool_parameters"]) where span.attributes["langfuse.observation.input"] == nil and span.attributes["tool_parameters"] != nil`,
      `set(span.attributes["langfuse.observation.output"], span.attributes["tool_output"]) where span.attributes["langfuse.observation.output"] == nil and span.attributes["tool_output"] != nil`,

      `set(span.attributes["langfuse.observation.type"], "generation") where span.name == "claude_code.llm_request" or span.attributes["span.type"] == "llm_request"`,
      `set(span.attributes["langfuse.observation.type"], "event") where span.name == "claude_code.tool" or span.name == "claude_code.tool.execution" or span.attributes["span.type"] == "tool" or span.attributes["span.type"] == "tool_execution"`,
      `set(span.attributes["langfuse.observation.model.name"], span.attributes["model"]) where span.attributes["langfuse.observation.model.name"] == nil and span.attributes["model"] != nil`,
      `set(span.attributes["langfuse.observation.model.name"], span.attributes["gen_ai.request.model"]) where span.attributes["langfuse.observation.model.name"] == nil and span.attributes["gen_ai.request.model"] != nil`,
      `set(span.attributes["gen_ai.usage.input_tokens"], span.attributes["input_tokens"]) where span.attributes["gen_ai.usage.input_tokens"] == nil and span.attributes["input_tokens"] != nil`,
      `set(span.attributes["gen_ai.usage.output_tokens"], span.attributes["output_tokens"]) where span.attributes["gen_ai.usage.output_tokens"] == nil and span.attributes["output_tokens"] != nil`,
      `set(span.attributes["gen_ai.usage.cache_read_tokens"], span.attributes["cache_read_tokens"]) where span.attributes["gen_ai.usage.cache_read_tokens"] == nil and span.attributes["cache_read_tokens"] != nil`,
      `set(span.attributes["gen_ai.usage.cache_creation_tokens"], span.attributes["cache_creation_tokens"]) where span.attributes["gen_ai.usage.cache_creation_tokens"] == nil and span.attributes["cache_creation_tokens"] != nil`,
      `set(span.attributes["gen_ai.usage.cost"], span.attributes["cost_usd"]) where span.attributes["gen_ai.usage.cost"] == nil and span.attributes["cost_usd"] != nil`,

      `set(span.attributes["langfuse.trace.metadata.organization_id"], span.attributes["organization.id"]) where span.attributes["organization.id"] != nil`,
      `set(span.attributes["langfuse.trace.metadata.user_account_uuid"], span.attributes["user.account_uuid"]) where span.attributes["user.account_uuid"] != nil`,
      `set(span.attributes["langfuse.trace.metadata.user_account_id"], span.attributes["user.account_id"]) where span.attributes["user.account_id"] != nil`,
      `set(span.attributes["langfuse.trace.metadata.terminal_type"], span.attributes["terminal.type"]) where span.attributes["terminal.type"] != nil`,
      `set(span.attributes["langfuse.trace.metadata.app_entrypoint"], span.attributes["app.entrypoint"]) where span.attributes["app.entrypoint"] != nil`,
      `set(span.attributes["langfuse.trace.metadata.prompt_id"], span.attributes["prompt.id"]) where span.attributes["prompt.id"] != nil`,
      `set(span.attributes["langfuse.trace.metadata.span_type"], span.attributes["span.type"]) where span.attributes["span.type"] != nil`,
      `set(span.attributes["langfuse.observation.metadata.organization_id"], span.attributes["organization.id"]) where span.attributes["organization.id"] != nil`,
      `set(span.attributes["langfuse.observation.metadata.user_account_uuid"], span.attributes["user.account_uuid"]) where span.attributes["user.account_uuid"] != nil`,
      `set(span.attributes["langfuse.observation.metadata.user_account_id"], span.attributes["user.account_id"]) where span.attributes["user.account_id"] != nil`,
      `set(span.attributes["langfuse.observation.metadata.terminal_type"], span.attributes["terminal.type"]) where span.attributes["terminal.type"] != nil`,
      `set(span.attributes["langfuse.observation.metadata.app_entrypoint"], span.attributes["app.entrypoint"]) where span.attributes["app.entrypoint"] != nil`,
      `set(span.attributes["langfuse.observation.metadata.prompt_id"], span.attributes["prompt.id"]) where span.attributes["prompt.id"] != nil`,
      `set(span.attributes["langfuse.observation.metadata.request_id"], span.attributes["request_id"]) where span.attributes["request_id"] != nil`,
      `set(span.attributes["langfuse.observation.metadata.tool_name"], span.attributes["tool_name"]) where span.attributes["tool_name"] != nil`,
      `set(span.attributes["langfuse.observation.metadata.tool_name"], span.attributes["tool.name"]) where span.attributes["tool_name"] == nil and span.attributes["tool.name"] != nil`,
      `set(span.attributes["langfuse.observation.metadata.mcp_server_name"], span.attributes["mcp_server.name"]) where span.attributes["mcp_server.name"] != nil`,
      `set(span.attributes["langfuse.observation.metadata.mcp_tool_name"], span.attributes["mcp_tool.name"]) where span.attributes["mcp_tool.name"] != nil`,
    ]
  }

  output {
    traces = [otelcol.processor.filter.drop_empty_native_generations.input]
  }
}

otelcol.processor.filter "drop_empty_native_generations" {
  error_mode = "ignore"

  traces {
    span = [
      `name == "claude_code.llm_request"`,
      `name == "claude_code.interaction" and status.code != STATUS_CODE_ERROR`,
    ]
  }

  output {
    traces = [otelcol.processor.batch.langfuse.input]
  }
}

otelcol.processor.batch "bridge" {
  timeout             = "1s"
  send_batch_size     = 512
  send_batch_max_size = 1024

  output {
    logs    = [otelcol.exporter.otlphttp.bridge.input]
    metrics = [otelcol.exporter.otlphttp.bridge.input]
  }
}

otelcol.processor.batch "langfuse" {
  timeout             = "1s"
  send_batch_size     = 512
  send_batch_max_size = 1024

  output {
    traces = [otelcol.exporter.otlphttp.langfuse.input]
  }
}

otelcol.exporter.otlphttp "bridge" {
  encoding = "json"

  client {
    endpoint = "http://telemetry-bridge:4318"
    auth     = otelcol.auth.bearer.bridge.handler

    tls {
      insecure = true
    }
  }
}

otelcol.exporter.otlphttp "langfuse" {
  encoding = "json"

  client {
    endpoint = "http://langfuse-web:3000/api/public/otel"
    auth     = otelcol.auth.basic.langfuse.handler
    headers  = {
      "x-langfuse-ingestion-version" = "4",
    }

    tls {
      insecure = true
    }
  }
}
